// Evidence items from the 2026 SEP Numeracy and Reading trackers.
var ITEMS = [{"id":"N-C-001","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Aboriginal Studies","ht":"Mr Rob Bury","demand":"Interpretation and critique of social, health, justice and education statistics; comparing rates across populations; evaluating the basis of quantitative claims about disadvantage.","task":"Task 1 Research Report (T4 Wk7 2025); Task 3 Major Project (T2 Wk8 2026)","artefact":"Task notification and marking criteria showing an explicit criterion for use/critique of statistical sources; 3 marked work samples across the achievement range (high/mid/low) with feedback on data interpretation.","etype":"Student work sample","due":"Term 2, Week 4","why":"Numeracy is explicitly taught and assessed through the curriculum, not incidental to it."},{"id":"N-C-002","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Ancient History","ht":"Mr Rob Bury","demand":"Chronological reasoning across BCE/CE, ordering and scaling of timelines, interpretation of archaeological quantitative data (site dimensions, population estimates, dating ranges and error margins).","task":"Task 1 Historical Investigation / source-based tasks; Trial HSC (T3 Wks 4-5)","artefact":"Annotated teaching and learning program showing where chronology and quantitative source analysis are explicitly taught; sample source-analysis questions with quantitative stimulus.","etype":"Program & planning document","due":"","why":"Programs describe expected progression in numerate skills aligned to syllabus outcomes."},{"id":"N-C-003","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Business Studies","ht":"Mr Rob Bury","demand":"HIGH VALUE. Financial ratio analysis, balance sheets and revenue statements, break-even, liquidity/gearing/profitability ratios, percentage change, forecasting.","task":"Task 3 Finance: 'Financial assessment and interpretation' (T2 Wk6 2026)","artefact":"Full task package (notification, stimulus, marking criteria); item-level analysis of the calculation and interpretation questions; comparison of student performance on calculation vs interpretation items; record of the reteach or adjustment that followed.","etype":"Data / student performance","due":"","why":"The school analyses achievement data and teachers adjust practice in response to trends - the impact half of the numeracy claim."},{"id":"N-C-004","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Economics","ht":"Mr Rob Bury","demand":"HIGH VALUE. Index numbers, CPI, unemployment and growth rates, elasticity calculations, terms of trade, reading and interpreting multi-axis graphs and time series.","task":"Task 2 Topic Test - multiple choice and short answer stimulus (T1 Wk7); Task 3 Stimulus-based in-class extended response (T2 Wk7)","artefact":"Stimulus materials with the numerical demand highlighted; item analysis of the stimulus/skills questions (20% weighting); marked responses showing use of calculated evidence in argument.","etype":"Data / student performance","due":"","why":"Consistent, comparable judgement about numerate skills within a subject area."},{"id":"N-C-005","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Geography","ht":"Mr Rob Bury","demand":"HIGHEST VALUE IN HSIE. 'Geographical tools and skills' is a discrete 20% assessment component: map scale and gradient, area and density calculation, climate graphs, statistical representation, fieldwork data collection and analysis.","task":"Task 2 Topic Test - Geographical Inquiry Skills and Tools (T1 Wk7); Task 3 In-class structured response, Fieldwork/Rural and Urban Places (T2 Wk8)","artefact":"Item analysis of the skills and tools test broken down by tool type; fieldwork data-processing samples; the marking criteria for the tools component; a short faculty statement on what the item analysis changed.","etype":"Data / student performance","due":"","why":"Explicit teaching of numeracy through the curriculum with evaluative processes measuring impact - directly matches the SEF Excelling descriptor."},{"id":"N-C-006","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"History Extension","ht":"Mr Rob Bury","demand":"Evaluating the quantitative evidence historians use; recognising selective or misleading use of statistics in historiographical argument.","task":"Task 1 Source-based task; Task 2 History Project","artefact":"Extracts from the History Project bibliography and analysis showing critique of quantitative evidence; teacher feedback on evaluation of statistical claims.","etype":"Student work sample","due":"","why":"Critical numeracy is taught at the top of the achievement range, not only for at-risk students."},{"id":"N-C-007","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Legal Studies","ht":"Mr Rob Bury","demand":"Interpretation of crime, recidivism, sentencing and court-delay statistics; using quantitative measures to judge the effectiveness of legal responses.","task":"Task 2 Essay; Trial HSC Examination (T3 Wks 4-5)","artefact":"Marked essays showing accurate use of statistics as evidence of effectiveness; the faculty's shared bank of current statistics and how students are taught to use it.","etype":"Student work sample","due":"","why":"Numeracy is embedded in the discipline's own standards of evidence."},{"id":"N-C-008","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Modern History","ht":"Mr Rob Bury","demand":"Interpretation of statistical sources - economic indicators, production and casualty figures, election results, demographic change - including reliability and usefulness judgements.","task":"Task 1 Source-based task; Trial HSC Examination (T3 Wks 4-5)","artefact":"Source booklets containing tables/graphs with the accompanying scaffold used to teach interpretation; marked student responses to the quantitative sources.","etype":"Student work sample","due":"","why":"Explicit strategies are used to break down numerate source material for students across the full range of abilities."},{"id":"N-C-009","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Society and Culture","ht":"Mr Rob Bury","demand":"HIGH VALUE. Quantitative research methods within the Personal Interest Project - sampling, questionnaire design and coding, statistical representation of findings, integration with qualitative methods.","task":"Task 1 PIP Proposal (T4 Wk7 2025); Task 3 Research Essay (T2 Wk5 2026)","artefact":"PIP methodology sections showing quantitative method selection and justification; the research-methods teaching sequence; the 'Application and evaluation of research methods' criteria (30% of the course).","etype":"Program & planning document","due":"","why":"Numeracy taught as a transferable research capability, evidenced in a NESA-marked major work."},{"id":"N-C-010","goal":"N","kind":"course","team":"HSIE","year":"Year 12","title":"Studies of Religion II","ht":"Mr Rob Bury","demand":"Census data on religious affiliation, demographic trend analysis, percentage change over time in Religion and Belief Systems in Australia post-1945.","task":"Task 3 Religion in Australia post-1945 (T2)","artefact":"Teaching resource and scaffold for census trend analysis; sample responses using accurate percentage and trend language.","etype":"Program & planning document","due":"","why":"Programs are dynamic and adjusted, with numerate content updated to current data."},{"id":"N-C-011","goal":"N","kind":"course","team":"Science","year":"Year 12","title":"Biology","ht":"Ms Traci Lewis","demand":"Working Scientifically is 60% of assessment: ratio and probability in inheritance (Punnett squares, expected vs observed), processing first-hand data, constructing and interpreting graphs, evaluating reliability and validity.","task":"Task 1 Model and Report, Module 5 Heredity (T4 Wk7 2025); Task 2 Skills task, Module 6 Genetic Change (T1 Wk7 2026)","artefact":"Marked Working Scientifically skills tasks with the data-processing criteria; before/after samples where a common numerical error was retaught; the faculty's shared data-analysis scaffold.","etype":"Student work sample","due":"","why":"Explicit numeracy teaching within a mandated syllabus skills strand, with evidence of impact."},{"id":"N-C-012","goal":"N","kind":"course","team":"Science","year":"Year 12","title":"Chemistry","ht":"Ms Traci Lewis","demand":"HIGH VALUE. Stoichiometry and mole calculations, concentration and dilution, logarithmic pH scale, equilibrium constants, titration data processing, significant figures and unit conversion.","task":"Task 2 Skills task (T1 Wk7 2026); Trial HSC Examination (T3 Wks 4-5)","artefact":"Item analysis of calculation questions by type (mole / concentration / log scale); the faculty's record of which calculation types students consistently fail and the intervention put in place.","etype":"Data / student performance","due":"","why":"Assessments used across a subject area to identify skill gaps for improvement - a direct Sustaining and Growing descriptor."},{"id":"N-C-013","goal":"N","kind":"course","team":"Science","year":"Year 12","title":"Earth and Environmental Science","ht":"Ms Traci Lewis","demand":"Geological time scale and orders of magnitude, rates of change, resource quantity estimation, graphing of environmental data sets.","task":"Task 2 Skills task (T1); Task 3 Depth Study (T2)","artefact":"Depth Study data sections with teacher annotation of quantitative reasoning; scaffold for working with very large and very small numbers.","etype":"Student work sample","due":"","why":"Numeracy demands specific to the discipline are named and taught rather than assumed."},{"id":"N-C-014","goal":"N","kind":"course","team":"Science","year":"Year 12","title":"Investigating Science","ht":"Ms Traci Lewis","demand":"HIGH VALUE. Task 3 'Fact or Fallacy?' requires students to analyse how science is portrayed in the media - critical evaluation of statistical claims, sample size, correlation vs causation, misleading graphs.","task":"Task 1 Depth Study practical investigation and report (T4 Wk7 2025); Task 3 Analysis and Report - Fact or Fallacy (T2 Wk6 2026)","artefact":"The Fact or Fallacy task and marking criteria; marked samples where students correctly identified a statistical fallacy; the explicit teaching sequence on evaluating quantitative media claims.","etype":"Student work sample","due":"","why":"Critical numeracy for life beyond school - strong narrative evidence for the panel and for parents/carers."},{"id":"N-C-015","goal":"N","kind":"course","team":"Science","year":"Year 12","title":"Physics","ht":"Ms Traci Lewis","demand":"HIGHEST VALUE IN SCIENCE. Task 2 is explicitly 'Analysing data, graphs and mathematical problem solving'. Also: linearisation of data, gradient as a physical quantity, uncertainty, vectors, unit manipulation.","task":"Task 2 Skills Task, Module 6 Electromagnetism - analysing data, graphs and mathematical problem solving (T1 Wk7 2026)","artefact":"The complete Task 2 package; item analysis by skill (graphing / algebraic manipulation / units); a comparison of student performance in Physics numeracy items against their Mathematics course enrolment and rank.","etype":"Data / student performance","due":"","why":"Cross-faculty triangulation - the single most persuasive evidence that numeracy is a whole-school not a Maths concern."},{"id":"N-C-016","goal":"N","kind":"course","team":"Science","year":"Year 12","title":"Science Extension","ht":"Ms Traci Lewis","demand":"HIGHEST VALUE OVERALL. Task 2 is a 'Statistical Case Study'. 'Gathering, recording, analysing and evaluating data' is a discrete 30% component.","task":"Task 2 Statistical Case Study (T2 Wk6 2026); Task 3 Scientific Research Report (T3 Wk3 2026)","artefact":"The Statistical Case Study task, marking criteria and marked samples; evidence of collaboration with the Mathematics faculty in designing or moderating it.","etype":"Student work sample","due":"","why":"Cross-faculty collaboration on numeracy - teachers collaborate across faculties to share curriculum knowledge and data."},{"id":"N-C-017","goal":"N","kind":"course","team":"PDHPE","year":"Year 12","title":"Community and Family Studies","ht":"Ms Voula Georgelos","demand":"HIGH VALUE. Research methodology for the Independent Research Project - sampling, questionnaire design and coding, presenting quantitative findings, interpreting ABS and AIHW population data. 'Skills in critical thinking, research, analysing and communication' is 60% of the course.","task":"Task 1 Research Methodology / Independent Research Project (T4 Wk8 2025)","artefact":"IRP methodology and results sections showing quantitative data handling; the research-methods teaching sequence; marking criteria for the analysis component.","etype":"Student work sample","due":"","why":"Numeracy taught as research capability across all achievement levels within a mandatory syllabus component."},{"id":"N-C-018","goal":"N","kind":"course","team":"PDHPE","year":"Year 12","title":"Health and Movement Science","ht":"Ms Voula Georgelos","demand":"HIGH VALUE. Task 1 requires training program evaluation and comparison - heart rate and %HRmax, training load and intensity, fitness test norms and percentiles, performance data over time. Task 3 uses local community health statistics.","task":"Task 1 Depth Study, Focus Area 2 - training program evaluation and comparison (T4 Wk6 2025); Task 3 Critical Thinking Task, health improvements in local community (T2 Wk8 2026)","artefact":"Student data sets and graphs from the training program evaluation; the Critical Thinking task showing use of local health statistics; marked samples across the range.","etype":"Student work sample","due":"","why":"Applied, contextual numeracy with authentic data - highly legible evidence for a panel."},{"id":"N-C-019","goal":"N","kind":"course","team":"PDHPE","year":"Year 12","title":"Sport, Lifestyle and Recreation Studies","ht":"Ms Voula Georgelos","deman